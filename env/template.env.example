# zed-cli environment schema — names and meanings only, never real values.
# Real values live encrypted in env/enc/<name>.env.enc (sops + age).
# Edit with `just edit <name>`; activate with `just use <name>`.
#
# Scope note: end users of the zed CLI supply their own credentials. This store
# holds DEVELOPER/TEST credentials only (a dev registry token, a test Supabase
# project, a throwaway test account) so `cargo run` / e2e sessions do not pass
# secrets through shell history.

# --- Registry ----------------------------------------------------------------
# Registry base URL. Identifier, not a secret. Read by the global `--registry`
# flag (src/cli.rs, clap `env = "ZED_PKG_REGISTRY"`); defaults to
# https://registry.zpkg.net (zed-interfaces DEFAULT_REGISTRY_URL). Dev uses the
# local registry, e.g. http://127.0.0.1:48090.
ZED_PKG_REGISTRY=EXAMPLE-http://127.0.0.1:48090
# Registry auth token; overrides saved credentials. SECRET. Read by the global
# `--token` flag (src/cli.rs, `env = "ZED_PKG_TOKEN"`, hide_env_values) and
# resolved in src/config.rs token precedence. Enter via `just edit <name>`
# ONLY — a token that transits chat, a shell command, or a plaintext file is
# burned and must be revoked (see the credential policy / DEN-2836).
ZED_PKG_TOKEN=EXAMPLE-enter-via-just-edit

# --- shared-auth / Supabase (human account auth) -----------------------------
# shared-auth base URL. Identifier; defaults to <registry>/shared-auth. Read by
# the global `--auth-url` flag (src/cli.rs, `env = "ZED_PKG_AUTH_URL"`).
ZED_PKG_AUTH_URL=EXAMPLE-http://127.0.0.1:48090/shared-auth
# Supabase project URL used for provider login/signup. Identifier. Read by the
# global `--supabase-url` flag (src/cli.rs) and required together with the key
# by src/auth.rs.
ZED_PKG_SUPABASE_URL=EXAMPLE-https://your-project-ref.supabase.co
# Supabase publishable/anon key (never a service-role key — src/cli.rs enforces
# the intent in its help text; public-by-design in shipped clients, but treated
# as a credential slot here). Read by `--supabase-key`
# (`env = "ZED_PKG_SUPABASE_KEY"`, hide_env_values).
ZED_PKG_SUPABASE_KEY=EXAMPLE-sb_publishable_xxx

# --- Test account (zed auth login/signup, src/auth.rs + src/cli.rs) ----------
# Email of the developer TEST account. Identifier.
ZED_PKG_AUTH_EMAIL=EXAMPLE-dev-test-account@example.com
# Password of the developer TEST account. SECRET. Read by read_password() in
# src/auth.rs (`ZED_PKG_AUTH_PASSWORD`); interactive prompt / --password-stdin
# are the alternatives.
ZED_PKG_AUTH_PASSWORD=EXAMPLE-enter-via-just-edit

# --- Not stored here (documentation only) ------------------------------------
# Native-host publish tokens (src/native_host_client.rs credential_env_vars):
# ZED_NPM_TOKEN / NPM_TOKEN, ZED_CARGO_TOKEN / CARGO_REGISTRY_TOKEN,
# ZED_PYPI_TOKEN, ... — per-ecosystem publish credentials supplied by the
# runner that publishes; add them to an env here only if a dev workflow needs
# them.
# Behavior toggles (non-secret; set ad hoc, not stored): ZED_PKG_HOME,
# ZED_PKG_FROZEN, ZED_PKG_INTERACTIVE, ZED_PKG_INSTALL_MODE,
# ZED_PKG_ALLOW_BUILD, ZED_PKG_TARGET, ZED_PKG_GLOBAL_BIN_DIR,
# ZED_PKG_MAX_{ARTIFACT,REGISTRY,UNPACKED}_BYTES, ZED_PKG_CONTEXT_*,
# ZED_PKG_FORCE_*, ZED_DEV_*, and the ZED_PKG_TEST_* variables (test-only).
